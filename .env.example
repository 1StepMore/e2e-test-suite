# Omni Suite — Environment Variables
# ===========================================================================
# Copy this file to `.env` in the project root. DO NOT commit `.env` to
# source control (it is gitignored).
#
# At minimum you need one LLM provider key for real translations.
# Free-tier priority: Zhipu > Agnes > NVIDIA NIM > OpenCode Go.
#
# Lookup precedence (highest first):
#   1. Real environment variable (shell export, CI secret, Docker -e, …)
#   2. `.env` file in the project root (auto-loaded by some tools)
#   3. Default value in source code
# ===========================================================================


# ===================================================================
# LLM Provider Keys — used by OL for translation, judging, restoration
# Reference: Omni_Localizer/config/default.yaml
# ===================================================================

# Zhipu BigModel (free-tier, primary in default.yaml translation)
ZHIPU_API_KEY=<your-zhipu-api-key>

# Agnes AI (free-tier, primary in default.yaml judging/restoration)
AGNES_API_KEY=<your-agnes-api-key>

# NVIDIA NIM (free-tier 40 RPM, used by deepseek-v4-flash and kimi-k2.6)
NVIDIA_NIM_API_KEY=<your-nvidia-nim-api-key>

# OpenCode Go (backup model — deepseek-v4-flash)
OPENCODE_GO_KEY=<your-opencode-go-key>
OPENCODE_GO_BASE_URL=<your-opencode-go-base-url>

# Baidu Qianfan (used in test configs — slim-test.yaml, test_universal.yaml)
# BAIDU_API_KEY=<your-baidu-api-key>
# BAIDU_BASE_URL=https://qianfan.baidubce.com/v2


# ===================================================================
# Shared — used by all 3 modules (OPP / OL / ORF)
# ===================================================================

# Cache directory for translation artifacts. Default: ~/.omni_cache
# OMNI_CACHE_DIR=~/.omni_cache

# Log format (json or console). Default: console
# OMNI_LOG_FORMAT=console

# Project root — used by production pipeline scripts
# OMNI_ROOT=/path/to/Omni_Suite

# Shared secret for MCP server authentication (all 3 modules)
# When set, every MCP tool call must include this secret.
# MCP_SHARED_SECRET=<your-mcp-shared-secret>


# ===================================================================
# Test / Dev Switches (shared)
# ===================================================================

# Set to 1 to short-circuit all LLM calls with placeholder responses
# (no real API keys needed). Used in CI and local testing.
# OMNI_TEST_FAKE_LLM=1

# Set to 1 to bypass pandoc for ORF format conversion (uses stub output)
# OMNI_TEST_FAKE_PANDOC=1

# Set to 1 to enable real-LLM test paths (requires a valid API key)
# OMNI_RUN_REAL_LLM=1


# ===================================================================
# OPP — Omni Pre-Processor
# ===================================================================

# Path to YAML config. Default: config/default.yaml (internal)
# OPP_CONFIG_PATH=config/default.yaml

# Log level (DEBUG, INFO, WARNING, ERROR)
# OPP_LOG_LEVEL=INFO

# OCR engine override (tesseract or rapidocr). Default: tesseract
OPP_OCR_ENGINE=tesseract

# OCR language for Tesseract (e.g., eng, chi_sim). Default: eng
# OPP_OCR_LANG=eng

# ASR engine for audio files (whisper)
# OPP_ASR_ENGINE=whisper

# Whisper model size (tiny, base, small, medium, large-v3). Default: tiny
# OPP_MODEL_SIZE=tiny

# Allowed directories for the CLI (comma-separated)
# OPP_ALLOWED_DIRECTORIES=/path/to/documents,/path/to/output

# Allowed directories for the OPP MCP server (comma-separated, colon on Linux)
# OPP_MCP_ALLOWED_DIRS=/tmp:/path/to/documents

# MCP server host. Default: 127.0.0.1
# OPP_MCP_HOST=127.0.0.1

# MCP server port. Default: 8766
# OPP_MCP_PORT=8766

# MCP max file size in bytes. Default: no limit
# OPP_MCP_MAX_FILE_SIZE=52428800

# MCP timeout in seconds. Default: 120
# OPP_MCP_TIMEOUT=120


# ===================================================================
# OL — Omni Localizer
# ===================================================================

# Path to YAML config. Default: config/default.yaml (module-relative)
# OL_CONFIG_PATH=config/default.yaml

# Path to an explicit .env file to load. Default: auto-discover in CWD
# OL_DOTENV=.env

# Log level (DEBUG, INFO, WARNING, ERROR)
# OL_LOG_LEVEL=INFO

# Log output directory
# OL_LOG_DIR=logs

# Set to 1 to mirror logs to stderr
# OL_LOG_CONSOLE=1

# Allowed directories for the OL MCP server (comma-separated)
# OL_ALLOWED_DIRECTORIES=/path/to/documents,/path/to/output

# Set to 1 to allow hardcoded API keys in YAML config (not recommended)
# OL_ALLOW_HARDCODED_KEYS=1


# ===================================================================
# ORF — Omni Re-Formatter
# ===================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
# ORF_LOG_LEVEL=INFO

# Allowed directories for the ORF MCP server (comma-separated, colon on Linux)
# Required for MCP server to accept file paths.
# ORF_MCP_ALLOWED_DIRS=/tmp:/path/to/documents

# MCP max file size in bytes
# ORF_MCP_MAX_FILE_SIZE=52428800

# MCP timeout in seconds
# ORF_MCP_TIMEOUT=120
