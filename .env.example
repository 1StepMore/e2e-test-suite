# Omni Suite — Environment Variables
# ===========================================================================
# Copy this file to `.env` in the project root or the respective module
# directory. DO NOT commit `.env` to source control (it is gitignored).
#
# At minimum you need one LLM provider key (MiniMax is the default) for
# real translations. The other keys are optional and used for failover.
#
# Lookup precedence (highest first):
#   1. Real environment variable (shell export, CI secret, Docker -e, …)
#   2. `.env` file in the module directory (auto-loaded by ol_cli)
#   3. `.env` file in the project root
# ===========================================================================


# ===================================================================
# Shared — used by all 3 modules (OPP / OL / ORF)
# ===================================================================

# Cache directory for translation artifacts (OPP + OL). Default: ~/.omni_cache
# OMNI_CACHE_DIR=~/.omni_cache

# Project root — used by production pipeline scripts (run_pipeline.sh)
# OMNI_ROOT=/path/to/Omni_Suite


# ===================================================================
# LLM Provider Keys — used by OL for translation, judging, restoration
# ===================================================================

# MiniMax (primary provider — used by default in config/default.yaml)
MINIMAX_API_KEY=<your-minimax-api-key>
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Baidu Qianfan (secondary/fallback provider)
BAIDU_API_KEY=<your-baidu-api-key>
BAIDU_BASE_URL=https://qianfan.baidubce.com/v2

# OpenAI (optional — for OpenAI-compatible models)
OPENAI_API_KEY=<your-openai-api-key>

# Anthropic (optional — for judging with Claude)
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Zhipu BigModel (free-tier, primary in default.yaml)
ZHIPU_API_KEY=<your-zhipu-api-key>
# Agnes AI (free-tier, primary in default.yaml judging/restoration)
AGNES_API_KEY=<your-agnes-api-key>
# NVIDIA NIM (free-tier 40 RPM, used by deepseek-v4-flash and kimi-k2.6)
NVIDIA_NIM_API_KEY=<your-nvidia-nim-api-key>


# ===================================================================
# OPP — Omni Pre-Processor
# ===================================================================

# OCR engine override (tesseract or rapidocr)
# OPP_OCR_ENGINE=tesseract

# OCR language for Tesseract (e.g., eng, chi_sim)
# OPP_OCR_LANG=eng

# ASR engine for audio files (whisper)
# OPP_ASR_ENGINE=whisper

# Whisper model size (tiny, base, small, medium, large-v3)
# OPP_MODEL_SIZE=tiny

# Allowed directories for the MCP server (comma-separated)
# OPP_ALLOWED_DIRECTORIES=/path/to/documents,/path/to/output


# ===================================================================
# OL — Omni Localizer
# ===================================================================

# Path to YAML config. Default: config/default.yaml
# OL_CONFIG_PATH=config/default.yaml

# Path to an explicit .env file to load. Default: auto-discover in CWD
# OL_DOTENV=.env

# Log level (DEBUG, INFO, WARNING, ERROR)
# OL_LOG_LEVEL=INFO

# Log output directory
# OL_LOG_DIR=logs

# Set to 1 to mirror logs to stderr
# OL_LOG_CONSOLE=1

# Set to 1 to short-circuit LLM calls in tests with placeholder responses
# OMNI_TEST_FAKE_LLM=1

# Set to 1 to enable real-LLM test paths (requires a valid API key)
# OMNI_RUN_REAL_LLM=1


# ===================================================================
# ORF — Omni Re-Formatter
# ===================================================================

# Allowed directories for the ORF MCP server (comma-separated)
# ORF_ALLOWED_DIRECTORIES=/path/to/documents,/path/to/output
