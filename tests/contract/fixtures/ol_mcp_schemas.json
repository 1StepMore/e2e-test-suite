  {
    "description": "Translate markdown text directly without file I/O.",
    "inputSchema": {
      "description": "Input for translate_md_text.",
      "properties": {
        "add_frontmatter": {
          "default": false,
          "description": "Add YAML frontmatter to output",
          "title": "Add Frontmatter",
          "type": "boolean"
        },
        "async_mode": {
          "default": false,
          "description": "If True, return immediately with a request_id and run translation in background. Poll via get_translation_status.",
          "title": "Async Mode",
          "type": "boolean"
        },
        "config_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to LLM config",
          "title": "Config Path"
        },
        "content": {
          "description": "Markdown text to translate",
          "title": "Content",
          "type": "string"
        },
        "glossary_max_terms": {
          "default": 5,
          "description": "Max relevant glossary terms per unit (CLI: --glossary-max-terms)",
          "maximum": 50,
          "minimum": 1,
          "title": "Glossary Max Terms",
          "type": "integer"
        },
        "glossary_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to JSON glossary file",
          "title": "Glossary Path"
        },
        "no_glossary": {
          "default": false,
          "description": "Disable glossary injection even if glossary_path is set (CLI: --no-glossary)",
          "title": "No Glossary",
          "type": "boolean"
        },
        "no_restoration": {
          "default": false,
          "description": "Skip the A12.4 post-translation placeholder restoration (CLI: --no-restoration)",
          "title": "No Restoration",
          "type": "boolean"
        },
        "shared_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shared secret for MCP auth (required if MCP_SHARED_SECRET env var is set)",
          "title": "Shared Secret"
        },
        "source_lang": {
          "description": "Source language code (e.g. en, zh, ja)",
          "title": "Source Lang",
          "type": "string"
        },
        "target_lang": {
          "description": "Target language code",
          "title": "Target Lang",
          "type": "string"
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional W3C Trace Context traceparent header to make this OL span a child of an upstream trace (e.g. from OPP extract_document).",
          "title": "Traceparent"
        }
      },
      "required": [
        "content",
        "source_lang",
        "target_lang"
      ],
      "title": "TranslateInput",
      "type": "object"
    },
    "name": "translate_md_text"
  },
