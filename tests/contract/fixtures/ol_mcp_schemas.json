  {
    "description": "Search translation memory for similar past translations.",
    "inputSchema": {
      "description": "Input for search_tm.",
      "properties": {
        "shared_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shared secret for MCP auth (required if MCP_SHARED_SECRET env var is set)",
          "title": "Shared Secret"
        },
        "source_lang": {
          "default": "en",
