[
  {
    "description": "Add translation entries to a TMX file. Creates the file if it doesn't exist. ML deps required for embedding-based features: pip install omni-localizer[ml].",
    "inputSchema": {
      "$defs": {
        "TMEntry": {
          "description": "Single entry for add_tm_entries.",
          "properties": {
            "source": {
              "description": "Source text",
              "title": "Source",
              "type": "string"
            },
            "source_lang": {
              "description": "Source language code (e.g. 'en')",
              "title": "Source Lang",
              "type": "string"
            },
            "target": {
              "description": "Target translation",
              "title": "Target",
              "type": "string"
            },
            "target_lang": {
              "description": "Target language code (e.g. 'zh')",
              "title": "Target Lang",
              "type": "string"
            }
          },
          "required": [
            "source",
            "target",
            "source_lang",
            "target_lang"
          ],
          "title": "TMEntry",
          "type": "object"
        }
      },
      "description": "Input for add_tm_entries.",
      "properties": {
        "entries": {
          "description": "List of translation entries to add",
          "items": {
            "$ref": "#/$defs/TMEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "shared_secret": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shared secret for MCP auth (required if MCP_SHARED_SECRET env var is set)",
          "title": "Shared Secret"
        },
        "tmx_path": {
          "description": "Path to .tmx file (created if missing)",
          "title": "Tmx Path",
          "type": "string"
        }
      },
      "required": [
        "tmx_path",
        "entries"
      ],
      "title": "TMAddInput",
      "type": "object"
    },
    "name": "add_tm_entries"
  },
